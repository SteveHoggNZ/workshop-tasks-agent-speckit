@page "/board"
@rendermode InteractiveServer
@using CRUDTasksWithAgent.Models
@using CRUDTasksWithAgent.Services
@inject TaskService TaskService
@inject TaskChangeNotifier Notifier

<PageTitle>Board</PageTitle>

<h1 class="mb-4">Board</h1>

<ul class="list-group">
    @foreach (var task in tasks)
    {
        <li class="list-group-item">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" checked="@task.IsComplete" @onchange="e => OnToggle(task, e)" id="board-@task.Id" />
                <label class="form-check-label" for="board-@task.Id" style="@(task.IsComplete ? "text-decoration: line-through; color: #888;" : "")">
                    @task.Title
                </label>
            </div>
        </li>
    }
</ul>

@code {
    private List<TaskItem> tasks = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var all = await TaskService.GetAllTasksAsync();
        tasks = all.OrderBy(t => t.IsComplete).ThenBy(t => t.Id).ToList();
    }

    private async Task OnToggle(TaskItem task, ChangeEventArgs e)
    {
        if (e.Value is bool isComplete)
        {
            await TaskService.SetTaskCompletionAsync(task, isComplete);
            await LoadAsync();
            Notifier.NotifyChanged();
        }
    }
}
