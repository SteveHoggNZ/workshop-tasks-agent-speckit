# Top-most EditorConfig. Line endings are intentionally NOT forced (repo has mixed CRLF/LF).
root = true

[*]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,slnx,mjs,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,razor}]
# --- Lint baseline (see docs/lint-baseline.md) ---
# Style rules reported as warnings during build (EnforceCodeStyleInBuild=true).
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.CA1822.severity = warning

# Naming: private/internal instance fields are _camelCase. Severity is "suggestion"
# (shown in IDEs, not counted in the build baseline) to keep the baseline stable.
dotnet_naming_rule.private_fields_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore_camel.severity = suggestion

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal, private_protected

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

[tests/**.cs]
# xUnit convention: Method_Scenario_Expected names. CA1707 would be pure noise here.
dotnet_diagnostic.CA1707.severity = none
